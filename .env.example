# Local Development Environment Variables
# Copy to .env (which is gitignored)

# Schema
SCHEMA_NAME=app

# App
VITE_APP_URL=http://localhost:5173

# Supabase Local Development
# These are defaults for `supabase start` and are safe to commit (local only)
VITE_SUPABASE_API_PROJECT_URL=http://localhost:54321
VITE_SUPABASE_AUTH_KEY_PUBLIC=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
VITE_SUPABASE_FUNCTIONS_URL=http://localhost:54321/functions/v1

# Useful for debugging
VITE_SUPABASE_DEV_STUDIO=http://localhost:54323
VITE_SUPABASE_DEV_MAILPIT=http://localhost:54324
VITE_SUPABASE_API_REST=http://localhost:54321/rest/v1
VITE_SUPABASE_API_GRAPHQL=http://localhost:54321/graphql/v1
VITE_SUPABASE_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# For production, create .env.production with:
# VITE_SUPABASE_API_PROJECT_URL=https://<ref>.supabase.co
# VITE_SUPABASE_AUTH_KEY_PUBLIC=<your-anon-key>
# VITE_SUPABASE_FUNCTIONS_URL=https://<ref>.supabase.co/functions/v1
# VITE_APP_URL=https://yourdomain.com
# (never commit .env.production — it contains secrets)
